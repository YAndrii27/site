# Database
MONGO_DATABASE_USERNAME=root
MONGO_DATABASE_PASSWORD=example
MONGO_DATABASE_HOST=localhost
MONGO_DATABASE_PORT=27017
MONGO_DATABASE_NAME=blog

SQLALCHEMY_DATABASE_URI=sqlite:///./admin.db

# CORS
CORS_ORIGINS=http://localhost:3000

# Security
SESSION_COOKIE_SECURE=False

# JWT
JWT_SECRET_KEY=replace_with_your_secret_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

VERSION=0.1.1

# If set to True, the application will run in interactive mode, prompting for admin setup on first run.
# Set to False to disable this behavior and use environment variables for initial admin credentials instead.
# See compose.yml for environment variable configuration.
INTERACTIVE_MODE=False